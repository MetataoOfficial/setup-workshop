/**
 * Waybar 配置 - 琥珀色悬浮圆角版
 * 适配 niri 滚动窗口管理器
 */
{
    "layer": "top", // 置于顶层
    "position": "right", // 靠边显示
    "width": 120, // "height": 36,

    // 设置边距，创造悬浮感
    "margin-top": 15,
    "margin-bottom": 15,
    "margin-right": 10,

    // 模块排列
    "modules-left": [
        "custom/separator",
        "niri/window"
    ],

    "modules-center": [
        "clock",
        "custom/separator",
        "pulseaudio",
        "backlight",
        "battery",
        "network",
        "custom/separator",
        "tray"
    ],

    "modules-right": [
        "niri/workspaces",
        "custom/separator"
    ],

    // 模块：工作区
    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true,
        "on-click": "activate"
    },

    // 模块：当前窗口标题
    "niri/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    // 模块：时间、日期、星期
    "clock": {
        "format": "{:%m-%d 󰃭\n%H:%M 󱑂}", // "format-alt": " {:%H:%M | %m月%d日 %a}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffc777'><b>{}</b></span>",
                "days": "<span color='#a9b1d6'>{}</span>",
                "weekdays": "<span color='#ff9e64'><b>{}</b></span>",
                "today": "<span color='#1a1b26' background='#ff9e64'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    },

    // 模块：音频
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 静音",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    // 模块：亮度
    "backlight": {
        "device": "intel_backlight", // AMD 显卡通常是 "amd_backlight"
        "format": "{icon} {percent}%",
        "format-icons": ["⠂", "⠅", "⠇", "⠗", "⠟", "⠿"],
        "on-scroll-up": "brightnessctl set 3%+",
        "on-scroll-down": "brightnessctl set 3%-",
        "smooth-scrolling-threshold": 1
    },

    // 模块：电池
    "battery": {
        "states": {
            "warning": 50,
            "critical": 25
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click": "xfce4-power-manager"
    },

    // 模块：网络
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 有线",
        "format-linked": "{ifname} (无IP)",
        "format-disconnected": "󰤭 断开",
        "tooltip-format-wifi": "{ipaddr} | 信号: {signaldBm}dBm",
        "max-length": 20
    },

    // 模块：系统托盘
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    // 模块：分隔符
    "custom/separator": {
        "format": " ",      // 可以换成" | · • - "
        "interval": "once",
        "tooltip": false
    }
}
