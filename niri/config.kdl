// =============================================================================
//        NIRI 极简配置 on Cell 键盘布局 with Tab 模式
// =============================================================================

// Installation::
// pacman -S rofi dms-shell lxqt-policykit breeze-cursors5 pactl elvish ghostty nvim evince nemo nemo-fileroller
//
// gsettings set org.nemo.desktop show-desktop-icons false
// gsettings set org.gnome.desktop.interface cursor-theme 'breeze-cursors-snow'
// gsettings set org.gnome.desktop.interface cursor-size 36
// gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
// gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

// Refs::
// - https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// - https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings

// Screenshots Dir
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// =============================================================================
//                             屏幕/显示器配置 (Outputs)
// =============================================================================
output "eDP-1" {
    mode "1920x1200@60"  // 保持原有的分辨率和刷新率
    scale 1.5            // 缩放比例
    position x=0 y=0
}

// 外接屏幕（根据 niri msg outputs 的实际名字修改）
output "HDMI-A-1" {
    // position x=-1920 y=0    // 将第二块屏幕放在主屏左侧
    position x=0 y=-1080    // 将第二块屏幕放在主屏上侧
}

// =============================================================================
//                             输入设备配置 (Input)
// =============================================================================
input {
    keyboard {
        xkb { layout "cell"; }
        repeat-delay 500
        repeat-rate 50
    }
}

// =============================================================================
//                             布局与外观 (Layout)
// =============================================================================
layout {
    center-focused-column "never" // always on-overflow
    always-center-single-column
    default-column-display "tabbed"
    gaps 10                                  // 参照 i3 配置
    preset-column-widths { proportion 0.75; }

    focus-ring {
        width 10
        active-color "#644264"
        inactive-color "#2f2a24"
    }

    // --- Tab 标签指示器外观定义 ---
    tab-indicator {
        position "right"
        place-within-column
        hide-when-single-tab
        width 15
        gap 1
        gaps-between-tabs 30
        corner-radius 12
        active-color "#B8860B" // 999966 D4AF37 FFD700 F1E2B4
        inactive-color "#366363" // "#3f2f3f"
    }
}

cursor {
    xcursor-theme "breeze-cursors-snow"
    xcursor-size 36                // 放大（默认一般是 24 像素）
}

// =============================================================================
//                         窗口规则 (Window Rules)
// =============================================================================
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id="lxqt-policykit-agent" // title?
    open-floating true
    open-focused true
}

// =============================================================================
//                         事件处理 (Event Responders)
// =============================================================================
switch-events {
    lid-close { spawn "dms" "ipc" "call" "lock" "lockAndOutputsOff"; }
}

// =============================================================================
//                             最近窗口切换 (Recent Windows)
// =============================================================================
recent-windows {
    debounce-ms 450
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 10
    }

    previews {
        max-height 240
        max-scale 0.5
    }

    binds {
        Mod+Tab         { next-window scope="all"; } //scope="output";
        Mod+Shift+Tab   { previous-window scope="all"; }
        Alt+Tab         { next-window     scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
        Alt+grave       { previous-window filter="app-id"; }
        Alt+Shift+grave { next-window     filter="app-id"; }
    }
}

// =============================================================================
//                             按键绑定 (Key Binds)
// =============================================================================
binds {
    Mod+grave { toggle-overview; }
    Mod+Shift+grave { toggle-overview; }

    // 最大化 Zoom
    Mod+Z repeat=false { maximize-column; }

    // 应用启动器 - eXec - current windows, desktop app(drun), commands(run)
    Mod+X repeat=false {
        spawn "rofi" "-theme" "gruvbox-dark" "-show" "combi" "-combi-modi" "window,drun,run" "-show-icons";
    }

    // 关闭当前窗口 Close
    Mod+Shift+C repeat=false { close-window; }

    // Vertical 垂直平铺与 Tab 标签页之间来回切换
    Mod+V repeat=false { toggle-column-tabbed-display; }

    // 锁屏与休眠 Blank
    Mod+Ctrl+B repeat=false { spawn "dms" "ipc" "call" "lock" "lockAndOutputsOff"; }
    Mod+Ctrl+Shift+B repeat=false {
        spawn "elvish" "-c" "dms ipc call lock lockAndOutputsOff; sleep 1; systemctl suspend";
    }

    // 清除通知 Message
    Mod+M repeat=false { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+M repeat=false { spawn "dms" "ipc" "call" "notifications" "clearAll"; }

    // 默认位置与尺寸
    Mod+0 repeat=false { center-column; }
    Mod+Shift+0 repeat=false { switch-preset-column-width; }

    // 尺寸微调
    Mod+Minus { set-window-height "-10%"; }
    Mod+Equal { set-window-height "+10%"; }
    Mod+BracketLeft  { set-column-width "-10%"; }
    Mod+BracketRight { set-column-width "+10%"; }

    // 左右切换焦点和移动窗口
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    // 进入 / 推出 Tab
    Mod+Shift+Left  { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }

    // 在列内各个 Tab 间切换焦点，或调整窗口前后顺序
    Mod+Down { focus-window-down; } // or-workspace-
    Mod+Up   { focus-window-up; }   // or-workspace-
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up   { move-window-up; }

    // 首尾列快速聚焦或移动
    Mod+HOME { focus-column-first; }
    Mod+END  { focus-column-last;  }
    Mod+Shift+HOME { move-column-to-first; }
    Mod+Shift+END  { move-column-to-last;  }

    // 把当前列移动到 上 / 下 一个工作区
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    // 移动到#i工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    // 传送到#i工作区
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // --- 应用程序启动 ---
    Mod+Return cooldown-ms=300 { spawn "ghostty"; }
    Mod+Space cooldown-ms=300 { spawn "firefox"; }
    Mod+Escape cooldown-ms=300 { spawn "evince"; }
    Mod+BackSpace cooldown-ms=300 { spawn "nemo"; }

    // 音量与亮度控制
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute         allow-when-locked=true { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "pactl" "set-source-mute" "@DEFAULT_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "3%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "3%-"; }

    // 截屏
    Print { screenshot; }
    Alt+Print { screenshot-window; }
}

// =============================================================================
//                               启动项 (Autostart)
// =============================================================================
environment {
    XCURSOR_SIZE "36"
    XCURSOR_THEME "breeze-cursors-snow"
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULE "fcitx"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gnome"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY" "LANG" "LC_ALL" "XMODIFIERS" "QT_IM_MODULE" "INPUT_METHOD" "SDL_IM_MODULE" "LC_CTYPE"
spawn-at-startup "/usr/bin/lxqt-policykit-agent"
spawn-at-startup "dms" "run"
spawn-at-startup "fcitx5" "-d" "--replace"
