// =============================================================================
//           NIRI 现代实验室配置 (基于 i3wm 习惯 & Cell 布局 & Tab 模式)
// =============================================================================

// Refs::
// https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings

// ## 1. 核心导航与移动
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + H / L / J / K` 或 `← / → / ↓ / ↑` | 切换左 / 右列，或切换列内下 / 上窗口 |
// | `Mod + Shift + H / L` 或 `← / →` | 将当前窗口向左 / 向右吞并或推出列 |
// | `Mod + Shift + J / K` 或 `↓ / ↑` | 在当前列 / Tab 组内下移 / 上移窗口顺序 |
// | `Mod + Y / G` | 切换到第一列 / 最后一列 |
// | `Mod + Shift + Y / G` | 将当前列移动到最前 / 最后 |
// | `Mod + Grave` 或 `Mod + Shift + Grave` | 打开 / 关闭总览 (Overview) |
//
// ## 2. 最近窗口切换 (Recent Windows)
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + Tab` / `Mod + Shift + Tab` | 在所有工作区中切换下一个 / 上一个最近窗口 |
// | `Alt + Tab` / `Alt + Shift + Tab` | 在当前工作区中切换下一个 / 上一个最近窗口 |
// | `Alt + Grave` / `Alt + Shift + Grave`| 切换同一应用的下一个 / 上一个窗口 |
//
// ## 3. 窗口、列尺寸与浮动 / Tab 管理
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + S` | 切换当前列：普通垂直平铺 / Tab 标签模式 |
// | `Mod + A` | 切换当前窗口：伪全屏（隐藏自身的顶栏UI，但保持小窗口平铺） |
// | `Mod + M` | 将当前列居中 |
// | `Mod + Z` | 最大化当前列 |
// | `Mod + /` / `Mod + Shift + /` | 正向 / 反向切换预设列宽 (35% / 50% / 65%) |
// | `Mod + V`  | 将当前列撑满屏幕剩余可用宽度 |
// | `Mod + [` / `Mod + ]` | 缩小 / 加宽当前列 (-15% / +15%) |
// | `Mod + -` / `Mod + =` | 缩短 / 加高当前窗口 (-15% / +15%) |
// | `Mod + ,` / `Mod + .` | 将右侧窗口并入当前列 / 将当前窗口从列中推出 |
// | `Mod + Shift + C` 或 `Mod + 鼠标中键` | 关闭当前窗口 |
//
// ## 4. 工作区管理
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + ;` | 返回上一个工作区 (Back-and-forth) |
// | `Mod + 1…9` | 切换到工作区 1–9 |
// | `Mod + Shift + 1…9` | 将当前列移动到工作区 1–9 |
// | `Mod + HOME / END` | 切换到工作区 1 / 9 |
// | `Mod + Shift + HOME / END` | 将当前列移动到工作区 1 / 9 |
// | `Mod + PageUp / PageDown` 或 `Mod + 滚轮` | 切换上 / 下工作区 |
// | `Mod + Shift + PageUp / PageDown` | 将当前列移动到上 / 下工作区 |
//
// **注意：** 若系统中的工作区数量不足 9，Niri 会按动态工作区规则解析该编号。
//
// ## 5. 应用启动与界面工具
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + X` | Rofi：窗口切换、应用启动、运行命令 |
// | `Mod + Return` 或 `Mod + T` | 启动终端 (Ghostty) |
// | `Mod + Space` 或 `Mod + W` | 启动浏览器 (Firefox) |
// | `Mod + Escape` 或 `Mod + E` | 启动编辑器 (Neovide) |
// | `Mod + BackSpace` 或 `Mod + F` | 启动文件管理器 (Dolphin) |
// | `Mod + D` | 启动文档阅读器 (Evince) |
// | `Mod + R` | 隐藏 / 显示顶部状态栏 (Waybar) |
// | `Mod + P` | 显示 Niri 快捷键提示面板 |
//
// ## 6. 多显示器
//
// 方向约定：`N = 左`、`I = 下`、`O = 上`、`U = 右`。
//
// | 快捷键 | 功能 |
// |---|---|
// | `Mod + N / I / O / U` | 聚焦对应方向的显示器 |
// | `Mod + Shift + N / I / O / U` | 将当前列移到对应方向的显示器 |
//
// ## 7. 系统控制
//
// | 快捷键 | 功能 |
// |---|---|
// | `Print` | 打开交互式截图 |
// | `Ctrl + Print` | 截取当前屏幕 |
// | `Alt + Print` | 截取当前窗口 |
// | `Mod + Ctrl + B` | 锁屏（`gtklock`；当前绑定不会主动关闭显示器） |
// | `Mod + Ctrl + Shift + B` | 挂起系统 (Suspend) |
// | `Mod + Ctrl + Shift + Q` | 退出 Niri |
// | 音量增减键 / 静音键 / 麦克风键 | 音量 ±3% / 切换输出静音 / 切换麦克风静音 |
// | 亮度增减键 | 屏幕亮度 ±3% |
//

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// =============================================================================
//                             屏幕/显示器配置 (Outputs)
// =============================================================================
output "eDP-1" {
    mode "1920x1200@60"  // 保持原有的分辨率和刷新率
    scale 1.5            // 缩放比例
    position x=0 y=0
}

// 示例：外接屏幕（根据 niri msg outputs 的实际名字修改）
output "HDMI-A-1" {
    // position x=-1920 y=0    // 将第二块屏幕放在主屏左侧
    position x=0 y=-1080    // 将第二块屏幕放在主屏上侧
}

// =============================================================================
//                             输入设备配置 (Input)
// =============================================================================
input {
    // 鼠标自动居中
    warp-mouse-to-focus mode="center-xy-always"

    keyboard {
        xkb {
            layout "cell" // 保持 CELL 布局
        }
        repeat-delay 500
        repeat-rate 50
    }
}

// =============================================================================
//                             布局与外观 (Layout)
// =============================================================================
layout {
    center-focused-column "on-overflow" // never  always
    always-center-single-column
    gaps 10                                  // 参照 i3 配置

    preset-column-widths {
        proportion 0.35 // 2/6
        proportion 0.50 // 3/6
        proportion 0.65 // 4/6
    }

    focus-ring {
        width 6
        active-color "#644264"
        inactive-color "#2f2a24"
    }

    // --- Tab 标签指示器外观定义 ---
    tab-indicator {
        // 可选位置：top, bottom, left, right（若习惯类似浏览器可设为 top）
        position "right"
        place-within-column
        hide-when-single-tab

        width 6
        gap 3
        gaps-between-tabs 30
        corner-radius 3

        active-color "#999966"
        inactive-color "#366363" // "#3f2f3f"
    }
}

// =============================================================================
//                             窗口规则 (Window Rules)
// =============================================================================
// 全局窗口规则
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    default-column-width { proportion 0.35; }
}

// xfce4-appfinder 专属弹出规则
window-rule {
    match app-id="^xfce4-appfinder$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 800; }
}

// =============================================================================
//                             最近窗口切换 (Recent Windows)
// =============================================================================
recent-windows {
    debounce-ms 450
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 0
    }

    previews {
        max-height 240
        max-scale 0.5
    }

    binds {
        Mod+Tab         { next-window scope="all"; } //scope="output";
        Mod+Shift+Tab   { previous-window scope="all"; }

        Alt+Tab         { next-window     scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
        Alt+grave       { previous-window filter="app-id"; }
        Alt+Shift+grave { next-window     filter="app-id"; }
    }
}

// =============================================================================
//                             按键绑定 (Key Binds)
// =============================================================================
binds {
    // toggle the hide/show of waybar
    Mod+R repeat=false { spawn "pkill" "-USR1" "-x" "waybar"; }

    // --- 1. 核心导航 (保持物理位置习惯) ---
    Mod+grave { toggle-overview; }
    Mod+Shift+grave { toggle-overview; }

    // 左右切换焦点和移动窗口
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+L { consume-or-expel-window-right; }
    Mod+Shift+Left  { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }

    // 在列内各个 Tab 间切换焦点
    Mod+J { focus-window-down; } // or-workspace-
    Mod+K { focus-window-up; }   // or-workspace-
    Mod+Down { focus-window-down; } // or-workspace-
    Mod+Up   { focus-window-up; }   // or-workspace-

    // 在当前列/Tab 组内调整窗口前后顺序
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up   { move-window-up; }

    // 首尾列快速聚焦与移动
    Mod+Y { focus-column-first; }
    Mod+G { focus-column-last; }
    Mod+Shift+Y { move-column-to-first; }
    Mod+Shift+G { move-column-to-last; }

    // 跳到第一个 / 最后一个工作区
    Mod+HOME { focus-workspace 1; }
    Mod+END  { focus-workspace 9; }

    // 把当前列移动到第一个 / 最后一个工作区
    Mod+Shift+HOME { move-column-to-workspace 1; }
    Mod+Shift+END  { move-column-to-workspace 9; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    // --- 2. 应用程序启动 ---
    Mod+Return cooldown-ms=300 { spawn "ghostty"; }
    Mod+T cooldown-ms=300 { spawn "ghostty"; }

    Mod+Space cooldown-ms=300 { spawn "firefox"; }
    Mod+W cooldown-ms=300 { spawn "firefox"; }

    Mod+Escape cooldown-ms=300 { spawn "neovide"; }
    Mod+E cooldown-ms=300 { spawn "neovide"; }

    Mod+BackSpace cooldown-ms=300 { spawn "dolphin"; }
    Mod+F cooldown-ms=300 { spawn "dolphin"; }

    Mod+D cooldown-ms=300 { spawn "evince"; }

    // 应用启动器 - current windows, desktop app(drun), commands(run)
    Mod+X { spawn "rofi" "-theme" "gruvbox-dark" "-show" "combi" "-modes" "combi" "-combi-modes" "window,drun,run"; }

    // --- 3. 工作区管理 ---
    // 分号：返回上一个工作区 (Back-and-forth)
    Mod+semicolon { focus-workspace-previous; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // --- 4. 窗口管理 & Tab 标签组 & 斜线/引号扩展操作 ---
    Mod+Shift+C cooldown-ms=300 { close-window; }
    Mod+Z { maximize-column; }
    // 扩展当前列填充屏幕剩下的空间
    Mod+V repeat=false { expand-column-to-available-width; }
    Mod+slash cooldown-ms=300 { switch-preset-column-width; }
    Mod+Shift+slash cooldown-ms=300 { switch-preset-column-width-back; }

    // 【Tab 模式切换】在垂直平铺与 Tab 标签页之间来回切换
    Mod+S { toggle-column-tabbed-display; }

    // 伪全屏
    Mod+A repeat=false { toggle-windowed-fullscreen; }

    Mod+M repeat=false { center-column; }

    // 精确的向右吞并/推出快捷键
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // 尺寸微调
    Mod+Minus { set-window-height "-15%"; }
    Mod+Equal { set-window-height "+15%"; }
    Mod+BracketLeft { set-column-width "-15%"; }
    Mod+BracketRight { set-column-width "+15%"; }

    // --- 5. 系统控制 --- 音量与亮度控制
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute         allow-when-locked=true { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "pactl" "set-source-mute" "@DEFAULT_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "3%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "3%-"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 锁屏与休眠
    Mod+Ctrl+B { spawn "gtklock"; } //"sh" "-c" "gtklock & sleep 1 && niri msg action power-off-monitors"; }
    Mod+Ctrl+Shift+B { spawn "systemctl" "suspend"; }

    // 退出
    Mod+Ctrl+Shift+Q { quit; }

    // 提示
    Mod+P { show-hotkey-overlay; }

    // 鼠标中键快速关闭窗口
    Mod+MouseMiddle repeat=false { close-window; }

    // --- 6. 多屏幕/多显示器控制 (Outputs) ---
    Mod+N     { focus-monitor-left; }
    Mod+I     { focus-monitor-down; }
    Mod+O     { focus-monitor-up; }
    Mod+U     { focus-monitor-right; }

    // 移动当前选中的列到其他显示器
    Mod+Shift+N     { move-column-to-monitor-left; }
    Mod+Shift+I     { move-column-to-monitor-down; }
    Mod+Shift+O     { move-column-to-monitor-up; }
    Mod+Shift+U     { move-column-to-monitor-right; }
}

// =============================================================================
//                               启动项 (Autostart)
// =============================================================================
environment {
    XMODIFIERS "@im=fcitx"
    QT_IM_MODULE "fcitx"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY" "LANG" "LC_ALL" "XMODIFIERS" "GTK_IM_MODULE" "QT_IM_MODULE" "INPUT_METHOD" "SDL_IM_MODULE" "LC_CTYPE"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1" // pacman -S polkit-gnome
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "fcitx5" "-d" "--replace"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "pamac-tray"
spawn-at-startup "xfce4-power-manager" "--no-daemon"
