// This is: ~/.config/xkb/symbols/cell
// to debug the layout: xkbcli compile-keymap --layout cell
// --- For X11: ---
// sudo cp ~/.config/xkb/symbols/cell /usr/share/X11/xkb/symbols/
// edit /usr/share/X11/xkb/rules/evdev.xml :
// <layout>
//   <configItem>
//     <name>cell</name>
//     <shortDescription>cell</shortDescription>
//     <description>ChnEngLayout</description>
//   </configItem>
// </layout>
// --- For wayland: ---
// gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'us'), ('xkb', 'cell')]"
//   then, use `Super + Space` to switch...
// OR
// mkdir -p ~/.config/xkb/rules
// nvim ~/.config/xkb/rules/evdev.xml  ::
// <?xml version="1.0" encoding="UTF-8"?>
// <!DOCTYPE xkbConfigRegistry SYSTEM "xkb.dtd">
// <xkbConfigRegistry version="1.1">
//   <layoutList>
//     <layout>
//       <configItem>
//         <name>cell</name>
//         <shortDescription>cell</shortDescription>
//         <description>Custom Cell Layout</description>
//         <countryList>
//           <iso3166Id>US</iso3166Id>
//         </countryList>
//         <languageList>
//           <iso639Id>eng</iso639Id>
//         </languageList>
//       </configItem>
//     </layout>
//   </layoutList>
// </xkbConfigRegistry>
// gsettings set org.gnome.desktop.input-sources show-all-sources true
// relogin to select it from the system setting kbd layouts
// --- lastly, set it in the WM rc is an easier way...

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1]= "CELL";

    // --- 功能键改写 ---
    key <CAPS> { [ Escape ] };      // CapsLock -> Escape
    // key <RTSH> { [ BackSpace ] };   // RightShift -> BackSpace (useless)
    // key <ESC>  { [ Escape ] };      // 保持 Escape (do not have to write)

    // --- 字母区重排 (核心逻辑) ---
    // 第一排 (QWERTY Row)
    key <AD03> { [ d, D ] };        // E 位 -> D
    key <AD04> { [ f, F ] };        // R 位 -> F
    key <AD05> { [ semicolon, colon ] }; // T 位 -> ;
    key <AD06> { [ slash, question ] };  // Y 位 -> /
    key <AD07> { [ y, Y ] };        // U 位 -> Y
    key <AD08> { [ g, G ] };        // I 位 -> G
    key <AD09> { [ r, R ] };        // O 位 -> R
    key <AD10> { [ p, P ] };        // P 位 -> P

    // 第二排 (Home Row)
    key <AC03> { [ e, E ] };        // D 位 -> E (与 E 位互换完成)
    key <AC04> { [ t, T ] };        // F 位 -> T
    key <AC05> { [ comma,  less ] };     // G 位 -> ,
    key <AC06> { [ period, greater ] };  // H 位 -> .
    key <AC07> { [ n, N ] };        // J 位 -> N
    key <AC08> { [ i, I ] };        // K 位 -> I
    key <AC09> { [ o, O ] };        // L 位 -> O
    key <AC10> { [ u, U ] };        // ; 位 -> U

    // 第三排 (Bottom Row)
    key <AB01> { [ z, Z ] };        // Z
    key <AB02> { [ x, X ] };        // X
    key <AB03> { [ c, C ] };        // C
    key <AB04> { [ v, V ] };        // V
    key <AB05> { [ b, B ] };        // B
    key <AB06> { [ m, M ] };        // N 位 -> M
    key <AB07> { [ h, H ] };        // M 位 -> H
    key <AB08> { [ j, J ] };        // , 位 -> J
    key <AB09> { [ k, K ] };        // . 位 -> K
    key <AB10> { [ l, L ] };        // / 位 -> L

    // --- 其他特殊符号 ---
    // key <TLDE> { [ grave, asciitilde ] };
    // key <BKSL> { [ backslash, bar ] };
};

// the end
