# ==============================================================================
# SWAY CONFIG
# ==============================================================================
# w定切分方向、s换堆叠模式、a选父子层级、f管悬浮状态、t做标记互换。5
# q是锁屏睡眠、d显示任务栏、e和x是执行、c是关闭、z和v是最大最小化。7
# 空格、Esc、回车、退格四键专用于浏览器、编辑器、终端、文件管理器；4
# 方向键是按方向移动, Page与数字键管工作区、屏幕不单独管理，无他。10

# === Variables ===
set $mod Mod4
set $moS Mod4+Shift
set $moC Mod4+Control

# DMS IPC
set $dmsc dms ipc call

# 应用程序配置
set $browser_launcher   firefox
set $browser_focuser    "(?i)firefox"
set $editor_launcher    neovide
set $editor_focuser     "(?i)neovide"
set $terminal_launcher  ghostty
set $terminal_focuser   "(?i)ghostty"
set $filer_launcher     nemo
set $filer_focuser      "(?i)nemo"

# === Appearance & General Behavior ===
font pango:hack 12px
show_marks yes
focus_wrapping workspace
workspace_auto_back_and_forth yes

# 窗口标题与边框：锁定为传统的浮动窗口样式
for_window [all] title_window_icon yes
floating_minimum_size 400 x 300
floating_modifier $mod
title_align center
default_border normal
default_floating_border normal

# 初始化为 Stacking（堆叠模式）
workspace_layout stacking

# 窗口间隙
gaps inner 1px

# === Autostart Applications ===
# 核心特权与认证代理
exec_always --no-startup-id /usr/bin/lxqt-policykit-agent

# 启动常用应用组
exec --no-startup-id dms run
exec --no-startup-id fcitx5 -d --replace
exec --no-startup-id sway-alttab-gui daemon

# 显示器配置：精确到像素与刷新的硬件声明
output eDP-1 resolution 1920x1200@60Hz

# 绑定语法：workspace <ws#i> output <显示器A> <备用显示器B>
workspace 1 output HDMI-A-1 eDP-1
workspace 2 output HDMI-A-1 eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1

# 键盘与输入法环境注入（完美修正 Xkb）
input type:keyboard {
    xkb_layout "cell"
}

# === Keybindings ===
# 多媒体控制（联动高效刷新信号）
bindsym XF86AudioRaiseVolume  exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ +3%"
bindsym XF86AudioLowerVolume  exec --no-startup-id "pactl set-sink-volume @DEFAULT_SINK@ -3%"
bindsym XF86AudioMute         exec --no-startup-id "pactl set-sink-mute   @DEFAULT_SINK@ toggle"
bindsym XF86AudioMicMute      exec --no-startup-id "pactl set-source-mute @DEFAULT_SOURCE@ toggle"

bindsym XF86MonBrightnessUp   exec --no-startup-id "brightnessctl set 3%+"
bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl set 3%-"

# 任务切换。backup: "rofi -theme gruvbox-dark -show combi -combi-modi window,drun,run -show-icons"
bindsym $mod+Tab exec --no-startup-id sway-alttab-gui show
bindsym $moS+Tab exec --no-startup-id sway-alttab-gui show

bindsym Mod1+Tab       exec --no-startup-id sway-alttab-gui show
bindsym Mod1+Shift+Tab exec --no-startup-id sway-alttab-gui show

# 锁屏与休眠 Quit
bindsym $moC+q exec --no-startup-id $dmsc lock lockAndOutputsOff
bindsym $moC+Shift+q exec --no-startup-id systemctl suspend

# 预设下一次切分为水平方向（下一个窗口并排在右边）splitWide
bindsym $mod+w splith
bindsym $moS+w splitv

# Drop bar/msg
bindsym $mod+d exec --no-startup-id $dmsc bar toggle index 0
bindsym $moS+d exec --no-startup-id $dmsc notifications clearAll

# 将当前聚焦的窗口在平铺与悬浮之间切换 Float
bindsym $mod+f focus mode_toggle
bindsym $moS+f floating toggle

# focus Ancestor
bindsym $mod+a focus parent
bindsym $moS+a focus child

# Change container layout -- Stacking or Split
bindsym $mod+s layout toggle stacking splitv

# Exec sth.
bindsym $mod+e exec --no-startup-id "rofi -dmenu -p 'Exec> ' -font 'Hack 16' | xargs swaymsg"

# mark a window with "TAG" and swap with it
bindsym $mod+t mark TAG
bindsym $moS+t swap container with mark TAG

# toggle fullscreen for the focused container Zoom
bindsym $mod+z fullscreen toggle

# 应用启动器 eXec
bindsym $mod+x exec --no-startup-id "rofi -theme gruvbox-dark -show combi -combi-modi window,drun,run -show-icons"

# 关闭窗口与底层命令透传 Close
bindsym $moS+c kill

# 暂存区 Vanish
bindsym $mod+v scratchpad show
bindsym $moS+v move scratchpad

# 应用精准聚焦与条件拉起
bindsym $mod+space     [app_id=$browser_focuser] focus
bindsym $moS+space     exec --no-startup-id $browser_launcher
bindsym $mod+Escape    [app_id=$editor_focuser] focus
bindsym $moS+Escape    exec --no-startup-id $editor_launcher
bindsym $mod+Return    [app_id=$terminal_focuser] focus
bindsym $moS+Return    exec --no-startup-id $terminal_launcher
bindsym $mod+BackSpace [app_id=$filer_focuser] focus
bindsym $moS+BackSpace exec --no-startup-id $filer_launcher

# 基础物理焦点切换（经典的上下左右）
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# 基础物理几何挪动
bindsym $moS+Left  move left
bindsym $moS+Down  move down
bindsym $moS+Up    move up
bindsym $moS+Right move right

# 工作区管理（1-4 极简映射）
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

bindsym $moS+1 move container to workspace number $ws1
bindsym $moS+2 move container to workspace number $ws2
bindsym $moS+3 move container to workspace number $ws3
bindsym $moS+4 move container to workspace number $ws4

# Gnome2 like workspacing
bindsym $mod+Page_Up   workspace prev
bindsym $mod+Page_Down workspace next
bindsym $moS+Page_Up   move container to workspace prev
bindsym $moS+Page_Down move container to workspace next

# === Window Rules ===
no_focus [window_role="pop-up"]
for_window [window_role="About"] floating enable

# 全屏自由浮动
# for_window [class=".*"] floating enable
# for_window [app_id=".*"] floating enable
