<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <!-- ================================================================ -->
  <!-- Theme -->
  <!-- ================================================================ -->
  <theme>
    <name>Default</name>
    <font name="Hack" size="12" />
    <cornerRadius>12</cornerRadius>
  </theme>

  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no">
    <osd style="thumbnail" />
    <fields>
        <field content="type" width="35%" />
        <field content="trimmed_identifier" width="35%" />
        <field content="title" width="50%" />
    </fields>
  </windowSwitcher>

  <!-- ================================================================ -->
  <!-- Keyboard -->
  <!-- ================================================================ -->
  <keyboard>
    <default />
    <repeatDelay>500</repeatDelay>
    <repeatRate>50</repeatRate>

    <keybind key="W-q">
      <action name="AutoPlace" policy="center" />
    </keybind>

    <!-- Whole screen -->
    <keybind key="W-w">
      <action name="ToggleFullscreen" />
    </keybind>

    <!-- Above on top -->
    <keybind key="W-a">
      <action name="ToggleAlwaysOnTop" />
    </keybind>

    <!-- Sticky: visible on all workspaces -->
    <keybind key="W-s">
      <action name="ToggleOmnipresent" />
    </keybind>

    <!-- Zoom -->
    <keybind key="W-z">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- Vanish -->
    <keybind key="W-v">
      <action name="Iconify" />
    </keybind>

    <!-- Close -->
    <keybind key="W-S-c">
      <action name="Close" />
    </keybind>

    <!-- eXec -->
    <keybind key="W-x">
      <action name="Execute"
        command="rofi -theme gruvbox-dark -show combi -combi-modi window,drun,run -show-icons" />
    </keybind>

    <keybind key="W-C-b">
      <action name="Execute"
        command="dms ipc call lock lockAndOutputsOff" />
    </keybind>

    <keybind key="W-C-S-b">
      <action name="Execute"
        command="dms ipc call lock lockAndOutputsOff; systemctl suspend" />
    </keybind>

    <keybind key="W-m">
      <action name="Execute"
        command="dms ipc call notifications toggle" />
    </keybind>

    <keybind key="W-S-m">
      <action name="Execute"
        command="dms ipc call notifications clearAll" />
    </keybind>

    <!-- Window Placement: Quarter Corners -->
    <keybind key="W-d">
      <action name="MoveToEdge" direction="left" snapWindows="no" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
    </keybind>

    <keybind key="W-e">
      <action name="MoveToEdge" direction="left" snapWindows="no" />
      <action name="MoveToEdge" direction="down" snapWindows="no" />
    </keybind>

    <keybind key="W-f">
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
    </keybind>

    <keybind key="W-t">
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="down" snapWindows="no" />
    </keybind>

    <keybind key="W-S-d">
      <action name="ToggleSnapToEdge" direction="up-left" />
    </keybind>

    <keybind key="W-S-e">
      <action name="ToggleSnapToEdge" direction="down-left" />
    </keybind>

    <keybind key="W-S-f">
      <action name="ToggleSnapToEdge" direction="up-right" />
    </keybind>

    <keybind key="W-S-t">
      <action name="ToggleSnapToEdge" direction="down-right" />
    </keybind>

    <!-- Window Movement: Relative Position -->
    <keybind key="W-n">
      <action name="MoveRelative" x="-150" y="0" />
    </keybind>

    <keybind key="W-i">
      <action name="MoveRelative" x="0" y="90" />
    </keybind>

    <keybind key="W-o">
      <action name="MoveRelative" x="0" y="-90" />
    </keybind>

    <keybind key="W-u">
      <action name="MoveRelative" x="150" y="0" />
    </keybind>

    <!-- Window Resizing: Grow -->
    <keybind key="W-y">
      <action name="ResizeRelative" left="150" />
    </keybind>

    <keybind key="W-g">
      <action name="ResizeRelative" bottom="90" />
    </keybind>

    <keybind key="W-r">
      <action name="ResizeRelative" top="90" />
    </keybind>

    <keybind key="W-p">
      <action name="ResizeRelative" right="150" />
    </keybind>

    <!-- Window Resizing: Shrink -->
    <keybind key="W-h">
      <action name="ResizeRelative" left="-150" />
    </keybind>

    <keybind key="W-j">
      <action name="ResizeRelative" bottom="-90" />
    </keybind>

    <keybind key="W-k">
      <action name="ResizeRelative" top="-90" />
    </keybind>

    <keybind key="W-l">
      <action name="ResizeRelative" right="-150" />
    </keybind>

    <!-- switcher -->
    <keybind key="W-Tab">
      <action name="NextWindow" />
    </keybind>

    <keybind key="W-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- 切换工作区：Super + PageUp / PageDown -->
    <keybind key="W-Prior">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-Next">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>

    <keybind key="W-S-Prior">
      <action name="SendToDesktop" to="left" follow="yes" wrap="yes" />
    </keybind>
    <keybind key="W-S-Next">
      <action name="SendToDesktop" to="right" follow="yes" wrap="yes" />
    </keybind>

    <!-- Workspaces -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>

    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>

    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>

    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>

    <!-- Move window to workspace without following -->
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="no" />
    </keybind>

    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="no" />
    </keybind>

    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="no" />
    </keybind>

    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="no" />
    </keybind>

    <!-- Multimedia -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"
        command="pactl set-sink-volume @DEFAULT_SINK@ +3%" />
    </keybind>

    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"
        command="pactl set-sink-volume @DEFAULT_SINK@ -3%" />
    </keybind>

    <keybind key="XF86AudioMute">
      <action name="Execute"
        command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>

    <keybind key="XF86MonBrightnessUp">
      <action name="Execute"
        command="brightnessctl set 3%+" />
    </keybind>

    <keybind key="XF86MonBrightnessDown">
      <action name="Execute"
        command="brightnessctl set 3%-" />
    </keybind>
  </keyboard>

  <!-- ================================================================ -->
  <!-- Workspaces -->
  <!-- ================================================================ -->
  <desktops>
    <popupTime>800</popupTime>
    <names>
        <name>1</name>
        <name>2</name>
        <name>3</name>
        <name>4</name>
    </names>
  </desktops>
</labwc_config>
