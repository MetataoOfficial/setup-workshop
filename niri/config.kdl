// =============================================================================
//           NIRI 现代实验室配置 (基于 i3wm 习惯 & Cell 布局 & Tab 模式)
// =============================================================================

// Refs::
// https://github.com/niri-wm/niri/blob/main/resources/default-config.kdl
// https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings

// =============================================================================
//                             屏幕/显示器配置 (Outputs)
// =============================================================================
output "eDP-1" {
    mode "1920x1200@60"  // 保持原有的分辨率和刷新率
    scale 1.5            // 缩放比例
    position x=0 y=0
}

// 示例：外接屏幕（根据 niri msg outputs 的实际名字修改）
output "HDMI-A-1" {
    // mode "1920x1080@60"
    // scale 1
    // position x=-1920 y=0    // 将第二块屏幕放在主屏左侧
    position x=0 y=1200    // 将第二块屏幕放在主屏上侧
}

// =============================================================================
//                             输入设备配置 (Input)
// =============================================================================
input {
    // 鼠标自动居中
    warp-mouse-to-focus mode="center-xy-always"
    // focus-follows-mouse

    keyboard {
        xkb {
            layout "cell" // 保持 CELL 布局
        }
        repeat-delay 250
        repeat-rate 40
    }
}

// =============================================================================
//                             布局与外观 (Layout)
// =============================================================================
layout {
    center-focused-column "never"
    always-center-single-column

    gaps 10                                  // 参照 i3 配置

    preset-column-widths {
        proportion 0.35 // 2/6
        proportion 0.50 // 3/6
        proportion 0.65 // 4/6
    }

    focus-ring {
        width 6
        active-color "#644264"
        inactive-color "#2f2a24"
    }

    // --- Tab 标签指示器外观定义 ---
    tab-indicator {
        // 可选位置：top, bottom, left, right（若习惯类似浏览器可设为 top）
        position "top"
        place-within-column
        hide-when-single-tab

        width 6
        gap 3
        gaps-between-tabs 30
        corner-radius 3

        active-color "#999966"
        inactive-color "#366363" // "#3f2f3f"
    }
}

animations {
    slowdown 1.1
}

// =============================================================================
//                             窗口规则 (Window Rules)
// =============================================================================
// 全局窗口规则
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    default-column-width { proportion 0.35; }
}

// xfce4-appfinder 专属弹出规则
window-rule {
    match app-id="^xfce4-appfinder$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 800; }
}

// =============================================================================
//                             最近窗口切换 (Recent Windows)
// =============================================================================
recent-windows {
    debounce-ms 450
    open-delay-ms 150

    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 30
        corner-radius 0
    }

    previews {
        max-height 240
        max-scale 0.5
    }

    binds {
        Mod+Tab         { next-window scope="all"; } //scope="output";
        Mod+Shift+Tab   { previous-window scope="all"; }

        Alt+Tab         { next-window     scope="workspace"; }
        Alt+Shift+Tab   { previous-window scope="workspace"; }
        Alt+grave       { previous-window filter="app-id"; }
        Alt+Shift+grave { next-window     filter="app-id"; }
    }
}

// =============================================================================
//                             按键绑定 (Key Binds)
// =============================================================================
binds {
    // --- 1. 核心导航 (保持物理位置习惯) ---
    Mod+grave { toggle-overview; }
    Mod+Shift+grave { toggle-overview; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }

    // 在列内各个 Tab 间切换焦点；若到了首尾则在工作区切换
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up   { focus-window-or-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Shift+Page_Down { move-window-down; }
    Mod+Shift+Page_Up   { move-window-up; }

    // --- 2. 应用程序启动 ---
    Mod+Return cooldown-ms=300 { spawn "ghostty"; }
    Mod+T cooldown-ms=300 { spawn "ghostty"; }

    Mod+Space cooldown-ms=300 { spawn "firefox"; }
    Mod+W cooldown-ms=300 { spawn "firefox"; }

    Mod+Escape cooldown-ms=300 { spawn "neovide"; }
    Mod+E cooldown-ms=300 { spawn "neovide"; }

    Mod+BackSpace cooldown-ms=300 { spawn "nemo"; }
    Mod+F cooldown-ms=300 { spawn "nemo"; }

    Mod+D cooldown-ms=300 { spawn "evince"; }

    // 应用启动器 - current windows, desktop app(drun), commands(run)
    Mod+X { spawn "rofi" "-show" "combi" "-modes" "combi" "-combi-modes" "window,drun,run"; }

    // --- 3. 工作区管理 ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // 跳到第一个 / 最后一个工作区
    Mod+Y { focus-workspace 1; }
    Mod+G { focus-workspace 9; }

    // 把当前列移动到第一个 / 最后一个工作区
    Mod+Shift+Y { move-column-to-workspace 1; }
    Mod+Shift+G { move-column-to-workspace 9; }

    // --- 4. 窗口管理 & Tab 标签组操作 ---
    Mod+Shift+C cooldown-ms=300 { close-window; }
    Mod+Z { maximize-column; }
    Mod+V cooldown-ms=300 { switch-preset-column-width; }
    Mod+Shift+V cooldown-ms=300 { switch-preset-column-width-back; }

    // 【Tab 模式切换】在垂直平铺与 Tab 标签页之间来回切换
    Mod+S { toggle-column-tabbed-display; }

    // 【窗口合并与移出】吞并相邻窗口进入当前列或推出
    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+L { consume-or-expel-window-right; }
    Mod+Shift+Left  { consume-or-expel-window-left; }
    Mod+Shift+Right { consume-or-expel-window-right; }

    // 精确的向右吞并/推出快捷键
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // 【Tab 内顺序调整】在当前列/Tab 组内调整窗口前后顺序
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up   { move-window-up; }

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { move-window-down; }
    Mod+Shift+WheelScrollUp   { move-window-up; }

    // 尺寸微调
    Mod+Minus { set-window-height "-15%"; }
    Mod+Equal { set-window-height "+15%"; }
    Mod+BracketLeft { set-column-width "-15%"; }
    Mod+BracketRight { set-column-width "+15%"; }

    // --- 5. 系统控制 --- 音量与亮度控制
    XF86AudioRaiseVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "+3%"; }
    XF86AudioLowerVolume { spawn "pactl" "set-sink-volume" "@DEFAULT_SINK@" "-3%"; }
    XF86AudioMute        { spawn "pactl" "set-sink-mute"   "@DEFAULT_SINK@" "toggle"; }
    XF86AudioMicMute     { spawn "pactl" "set-source-mute" "@DEFAULT_SOURCE@" "toggle"; }
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "3%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "3%-"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // 锁屏与休眠
    Mod+Ctrl+B { spawn "sh" "-c" "gtklock & sleep 0.1 && niri msg action power-off-monitors"; }
    Mod+Ctrl+Shift+B { spawn "systemctl" "suspend"; }

    // 重载配置与退出
    Mod+Ctrl+R { spawn "niri" "msg" "action" "do-screen-transition" "---" "reload-config"; }
    Mod+Ctrl+Q { quit; }

    Mod+P { show-hotkey-overlay; }

    Mod+A repeat=false { focus-workspace-previous; }
    Mod+M repeat=false { center-column; }

    // 鼠标中键快速关闭窗口
    Mod+MouseMiddle repeat=false { close-window; }

    // --- 6. 多屏幕/多显示器控制 (Outputs) ---
    Mod+N     { focus-monitor-left; }
    Mod+I     { focus-monitor-up; }
    Mod+O     { focus-monitor-down; }
    Mod+U     { focus-monitor-right; }
    Mod+Ctrl+N     { focus-monitor-left; }
    Mod+Ctrl+I     { focus-monitor-up; }
    Mod+Ctrl+O     { focus-monitor-down; }
    Mod+Ctrl+U     { focus-monitor-right; }
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Right { focus-monitor-right; }

    // 移动当前选中的列到其他显示器
    Mod+Shift+N     { move-column-to-monitor-left; }
    Mod+Shift+I     { move-column-to-monitor-up; }
    Mod+Shift+O     { move-column-to-monitor-down; }
    Mod+Shift+U     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+N     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+I     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+O     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+U     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
}

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// =============================================================================
//                               启动项 (Autostart)
// =============================================================================
environment {
    LANG "zh_CN.UTF-8"
    LC_ALL "zh_CN.UTF-8"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    INPUT_METHOD "fcitx"
    SDL_IM_MODULE "fcitx"
    LC_CTYPE "zh_CN.UTF-8"
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "DISPLAY" "LANG" "LC_ALL" "XMODIFIERS" "GTK_IM_MODULE" "QT_IM_MODULE" "INPUT_METHOD" "SDL_IM_MODULE" "LC_CTYPE"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "fcitx5" "-d" "--replace"
// spawn-at-startup "~/bin/fcitx5-x11"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "pamac-tray"
spawn-at-startup "xfce4-power-manager" "--no-daemon"

