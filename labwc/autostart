#!/bin/sh

# 环境变量设置
export XCURSOR_SIZE=36
export XCURSOR_THEME="breeze-cursors-snow"
export XMODIFIERS="@im=fcitx"
export QT_IM_MODULE="fcitx"
export QT_QPA_PLATFORM="wayland"
export QT_QPA_PLATFORMTHEME="gnome"

# 启动时向 systemd 与 D-Bus 传递环境变量
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY LANG LC_ALL XMODIFIERS QT_IM_MODULE INPUT_METHOD SDL_IM_MODULE LC_CTYPE

# 启动认证代理
/usr/bin/lxqt-policykit-agent &

# 启动输入法
fcitx5 -d --replace &

# 屏幕缩放
wlr-randr --output eDP-1 --scale 1.33 &

# 常备终端
ghostty &

# 启动 DMS 守护进程
dms run &
